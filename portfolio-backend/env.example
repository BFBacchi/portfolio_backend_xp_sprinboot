# Arranque local (desde esta carpeta): mvn spring-boot:run
#   (no usar "springboot" junto — el goal es spring-boot:run)
#
# Copiar a variables de entorno en EasyPanel (no commitear secretos)
# En local, copiar a .env: Spring Boot lo carga al arrancar (mvn spring-boot:run) si el cwd es esta carpeta.
PORT=8080
# JDBC: debe ser jdbc:postgresql:// (con "ql"). Nunca jdbc:postgres:// — Spring no detecta el driver.
# Opcional: postgres://user:pass@host:5432/db (EasyPanel / Railway) — se convierte a JDBC al arrancar.
# En Docker/EasyPanel mismo proyecto: host interno del servicio Postgres, sin credenciales en la URL:
# DATABASE_URL=jdbc:postgresql://nombre_servicio_postgres:5432/nombre_base?sslmode=disable
DATABASE_URL=jdbc:postgresql://TU_HOST_POSTGRES:5432/portfolio_db
DATABASE_USER=portfolio_user
DATABASE_PASSWORD=cambiar_en_produccion
# Orígenes del front (HTTPS en prod), sin barra final. En EasyPanel deben estar en Environment del servicio en ejecución, no solo como build-arg.
CORS_ALLOWED_ORIGINS=https://tu-dominio-frontend.com,https://www.tu-dominio-frontend.com

# JWT (HS256): secreto largo, ≥ 32 caracteres recomendado
JWT_SECRET=cambiar-por-secreto-largo-en-produccion-minimo-32-chars
JWT_EXPIRATION_MS=86400000

# Groq assistant (Clippy IA)
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=350
GROQ_TIMEOUT_MS=12000
GROQ_TEMPERATURE=0.3

# Usuario inicial (solo si la tabla portfolio_users está vacía al arrancar)
PORTFOLIO_ADMIN=admin
PORTFOLIO_ADMIN_PASSWORD=cambiar_en_produccion
