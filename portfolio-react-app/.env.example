# --- Elige UNA de estas formas de trabajar en local ---

# A) Backend SOLO en la nube (sin Java en tu PC)
#    Pon la URL de tu Spring Boot. El navegador llamará directo (no usa proxy).
#    En el servidor: CORS_ALLOWED_ORIGINS debe incluir http://localhost:5173
#
# VITE_API_BASE_URL=https://tu-backend.easypanel.host

# B) Backend en tu máquina (puerto 8080)
#    Deja VITE_API_BASE_URL vacío y ejecuta: mvn spring-boot:run en portfolio-backend
#
VITE_API_BASE_URL=

# Opcional: si usas B) pero Spring escucha en otro host/puerto (solo Vite, no va al bundle)
# DEV_PROXY_TARGET=http://127.0.0.1:9090

# --- Docker / Easypanel ---
# Opción proxy (recomendada, mismo proyecto): en el contenedor del front define
#   API_UPSTREAM=http://nombre_servicio_backend:8080
# y NO pongas VITE_API_BASE_URL en el build.
#
# Opción URL pública en el bundle:
#   docker build --build-arg VITE_API_BASE_URL=https://tu-backend... .
